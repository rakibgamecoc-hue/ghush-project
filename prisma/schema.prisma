generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model BribeReport {
  id                 String        @id @default(uuid())
  departmentCategory String
  serviceType        String
  stateRegion        String
  districtLocation   String
  amountDemanded     Decimal       @db.Decimal(10,2)
  outcome            Outcome
  narrativeText      String
  verificationStatus String        @default("Unverified")
  agreeVotes         Int           @default(0)
  disagreeVotes      Int           @default(0)
  reviewStatus       ReviewStatus  @default(PENDING)
  createdAt          DateTime      @default(now())

  @@index([stateRegion])
  @@index([departmentCategory])
  @@index([outcome])
  @@index([createdAt])
  @@index([amountDemanded])
  @@index([reviewStatus, createdAt])
}

enum Outcome {
  PAID
  REJECTED
  PENDING
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}
