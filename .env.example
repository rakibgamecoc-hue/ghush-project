# Database
DATABASE_URL="postgres://user:pass@host:5432/db?sslmode=require"
POSTGRES_URL_NON_POOLING="postgres://user:pass@host:5432/db?sslmode=require"
POSTGRES_URL="postgres://user:pass@host:5432/db?sslmode=require"

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# Gemini LLM API Key (PII redaction, toxicity, usefulness scoring)
GEMINI_API_KEY="your-gemini-api-key"

# Admin panel (required for /admin routes)
ADMIN_PASSWORD="choose-a-strong-shared-password"
# Optional: separate secret for signing admin session cookies. Falls back to ADMIN_PASSWORD-derived value.
ADMIN_SESSION_SECRET=""

# Public site URL (used in sitemap, robots, OG tags)
NEXT_PUBLIC_SITE_URL="https://your-domain.com"
